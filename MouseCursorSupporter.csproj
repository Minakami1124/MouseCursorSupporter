<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>MouseCursorSupporter</AssemblyName>
    <Product>マウスカーソル自動切替</Product>
    <Company>ryokamur</Company>
    <Version>0.4.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- NU1510: the Windows Desktop shared framework already carries this, but keeping the
         reference explicit documents why Shift-JIS zip entry names decode correctly. -->
    <NoWarn>NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed to decode Shift-JIS (codepage 932) zip entry names; .NET no longer includes
         legacy codepages by default. -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.0" />
  </ItemGroup>

</Project>